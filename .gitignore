# config-baseline.json and config-baseline.core.json ARE tracked, but stay listed here on purpose:
# oxfmt honors .gitignore and these generated baselines use the generator's JSON layout, not
# oxfmt's. Un-ignoring them makes `pnpm format:check` fail and `pnpm format` rewrite generated
# artifacts.
docs/.generated/config-baseline.json
docs/.generated/config-baseline.core.json
docs/.generated/config-baseline.channel.json
