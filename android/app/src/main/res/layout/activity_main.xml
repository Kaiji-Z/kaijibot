<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_void"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="56dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp">

        <!-- ASCII Hero -->
        <TextView
            android:id="@+id/asciiArt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="monospace"
            android:textColor="@color/accent"
            android:textSize="9sp"
            android:lineSpacingExtra="1dp"
            android:shadowColor="@color/accent"
            android:shadowRadius="8"
            android:gravity="center"
            android:text="" />

        <!-- Divider -->
        <View
            android:layout_width="80dp"
            android:layout_height="1dp"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="@color/accent_dim" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:text="Think. Learn. Reach out."
            android:textColor="@color/ink_3"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

        <!-- Status pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Termux 已就绪"
                android:textColor="@color/accent"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Terminal block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/bg_inset"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/accent_dim"
                android:alpha="0.3"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="// 粘贴到 Termux 执行"
                android:textColor="@color/ink_3"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/installCmd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="$ curl -fsSL https://gitee.com/kaiji1126/kaijibot/raw/main/scripts/install-termux.sh | bash"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Status message (hidden by default, shown during install) -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text=""
            android:textColor="@color/ink_2"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Primary CTA -->
        <Button
            android:id="@+id/actionButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@color/accent"
            android:text="复制命令并打开 Termux"
            android:textColor="@color/bg_void"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Secondary link -->
        <Button
            android:id="@+id/hintButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="重新复制命令"
            android:textColor="@color/ink_2"
            android:textSize="14sp" />

        <!-- Nav link -->
        <Button
            android:id="@+id/helpButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:text="~ /常用操作"
            android:textColor="@color/ink_3"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
