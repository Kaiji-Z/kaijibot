<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_atmosphere"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="56dp"
        android:paddingHorizontal="20dp"
        android:paddingBottom="32dp">

        <ImageView
            android:id="@+id/asciiBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ascii_banner" />

        <ImageView
            android:layout_width="80dp"
            android:layout_height="2dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/bg_gradient_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:text="Think. Learn. Reach out."
            android:textColor="@color/ink_2"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="24dp" />

        <!-- Status indicator — terminal inline style -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:text="// termux: ready"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:layout_marginBottom="20dp" />

        <!-- Terminal block -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_terminal"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="// 粘贴到 Termux 执行"
                android:textColor="@color/ink_3"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/installCmd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="$ curl -fsSL https://gitee.com/kaiji1126/kaijibot/raw/main/scripts/install-termux.sh | bash"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!-- Primary CTA with glow -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_button_glow" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/actionButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:backgroundTint="@color/accent"
                app:rippleColor="#33FFFFFF"
                android:text="复制命令并打开 Termux"
                android:textColor="@color/bg_void"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:elevation="6dp"
                app:strokeWidth="0dp" />

        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"
            android:background="@color/line" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openWebUiButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:backgroundTint="@color/bg_surface"
            app:rippleColor="@color/accent_dim"
            app:strokeColor="@color/line"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:text="打开控制面板"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/helpButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:text="~ /常用操作"
            android:textColor="@color/ink_2"
            android:textSize="13sp"
            app:rippleColor="@color/accent_dim" />

    </LinearLayout>
</ScrollView>
