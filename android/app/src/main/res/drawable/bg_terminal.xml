<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_inset" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
    <item android:gravity="top|center_horizontal" android:width="200dp" android:height="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@android:color/transparent"
                android:centerColor="@color/accent_dim"
                android:endColor="@android:color/transparent"
                android:angle="0" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
